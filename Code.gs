/** APM 4.0 — API para Google Apps Script vinculada a uma Planilha Google.
 * Publique como aplicativo da web. Para leituras pelo navegador, a implantação
 * precisa permitir acesso ao público autorizado pelo proprietário.
 */
const HEADERS=['Data/Hora','Ativo','Condição do Sensor','Horímetro Total (h)','Vibração RMS (mm/s)','Temperatura (°C)','Corrente L1 (A)','Energia (kWh)','Índice de Saúde','Estado da Operação','Tipo de Manutenção','Ação Recomendada / Diagnóstico'];
function output(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function sheet(){const s=SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();if(s.getLastRow()===0)s.appendRow(HEADERS);return s}
function val(o,keys,fallback){for(const k of keys){if(o[k]!==undefined&&o[k]!==null&&o[k]!=='')return o[k]}return fallback}
function num(o,keys){const n=Number(String(val(o,keys,0)).replace(',','.'));return Number.isFinite(n)?n:0}
function diagnose(t,v,c,condition){let issues=[];if(t>=80)issues.push('Temperatura ≥ 80°C');if(v>=7.1)issues.push('Vibração ≥ 7,1 mm/s');if(c>=45)issues.push('Corrente ≥ 45A');if(issues.length)return ['CRÍTICO','CORRETIVA / AVALIAÇÃO URGENTE','Solicitar avaliação imediata conforme procedimento de segurança. Limites: '+issues.join(', ')+'. Verificar equipamento e confirmar medição do sensor '+condition+'.'];if(t>=65)issues.push('Temperatura ≥ 65°C');if(v>=4.5)issues.push('Vibração ≥ 4,5 mm/s');if(c>=35)issues.push('Corrente ≥ 35A');if(issues.length)return ['ALERTA','PREVENTIVA / PREDITIVA','Programar inspeção. Limites: '+issues.join(', ')+'. Verificar ativo, instalação e calibração do sensor '+condition+'.'];return ['NORMAL','NENHUMA','Operação dentro dos limites configurados.']}
function doPost(e){try{const data=e&&e.postData&&e.postData.contents?JSON.parse(e.postData.contents):(e&&e.parameter||{});const ativo=String(val(data,['asset','ativo'],'Skid MB-01'));let condition=String(val(data,['sensorCondition','condicaoSensor','sensorAge'],'ANTIGO')).toUpperCase();if(!['NOVO','ANTIGO'].includes(condition))condition='ANTIGO';const t=num(data,['temperature','temperatura']),v=num(data,['vibration','vibracaoRMS','vibracao']),c=num(data,['current','correnteL1','corrente']);const d=diagnose(t,v,c,condition);const lock=LockService.getScriptLock();lock.waitLock(10000);try{sheet().appendRow([new Date(),ativo,condition,val(data,['horimetroTotal','horimetro','horimetroTrip'],''),v,t,c,val(data,['totalKWh','energiaAcumulada','energia'],''),val(data,['healthIndex','indiceSaude','saude'],'100%'),...d]);}finally{lock.releaseLock()}return output({status:'sucesso',estado:d[0],condicaoSensor:condition,tipoManutencao:d[1],acaoRecomendada:d[2]})}catch(err){return output({status:'erro',message:String(err)})}}
function doGet(e){try{const s=sheet(),last=s.getLastRow();if(last<2)return output({status:'sucesso',leituras:[]});const count=Math.min(200,last-1),rows=s.getRange(last-count+1,1,count,12).getValues();const leituras=rows.map(r=>({data:r[0] instanceof Date?r[0].toISOString():r[0],ativo:r[1],condicaoSensor:r[2],horimetro:r[3],vibracao:r[4],temperatura:r[5],corrente:r[6],energia:r[7],saude:r[8],estado:r[9],tipoManutencao:r[10],acaoRecomendada:r[11]}));return output({status:'sucesso',leituras})}catch(err){return output({status:'erro',message:String(err)})}}
